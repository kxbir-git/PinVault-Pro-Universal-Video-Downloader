# ===========================================
# PinVault Pro – Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ===========================================

# ── App ──────────────────────────────────
NODE_ENV=development
APP_NAME="PinVault Pro"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# ── Database ─────────────────────────────
POSTGRES_DB=pinvaultpro
POSTGRES_USER=pinvault
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://pinvault:CHANGE_ME_STRONG_PASSWORD@localhost:5432/pinvaultpro
DATABASE_SSL=false

# ── Redis ────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379

# ── JWT / Auth ───────────────────────────
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING_HERE_USE_OPENSSL_RAND
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_RANDOM_REFRESH_SECRET_HERE
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── OAuth – Google ────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── OAuth – Facebook ─────────────────────
FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=YOUR_FACEBOOK_APP_SECRET
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/auth/facebook/callback

# ── OAuth – Apple ────────────────────────
APPLE_CLIENT_ID=YOUR_APPLE_SERVICE_ID
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_PRIVATE_KEY_PATH=./certs/apple_private_key.p8

# ── Stripe ───────────────────────────────
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_YOUR_MONTHLY_PRICE_ID
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_YOUR_YEARLY_PRICE_ID

# ── AWS S3 / Cloudflare R2 ───────────────
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=pinvaultpro-downloads
# For Cloudflare R2 (set endpoint to override S3):
# AWS_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# ── Python Microservice ──────────────────
PYTHON_SERVICE_URL=http://localhost:8000
PYTHON_SERVICE_API_KEY=CHANGE_ME_PYTHON_SERVICE_SECRET

# ── Email (AWS SES or SendGrid) ──────────
EMAIL_FROM=noreply@pinvaultpro.com
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=YOUR_SES_SMTP_USER
SMTP_PASS=YOUR_SES_SMTP_PASS
# OR SendGrid:
# SENDGRID_API_KEY=SG.YOUR_SENDGRID_API_KEY

# ── Security ─────────────────────────────
BCRYPT_SALT_ROUNDS=12
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_AES_KEY_HERE_32
ALLOWED_ORIGINS=http://localhost:3000,https://pinvaultpro.com
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# ── Rate Limiting ────────────────────────
RATE_LIMIT_FREE_REQUESTS=100
RATE_LIMIT_FREE_WINDOW_MS=900000
RATE_LIMIT_PREMIUM_REQUESTS=1000
RATE_LIMIT_PREMIUM_WINDOW_MS=900000

# ── MFA ──────────────────────────────────
MFA_ISSUER="PinVault Pro"
MFA_ENCRYPTION_KEY=CHANGE_ME_MFA_32_CHAR_ENCRYPTION_KEY

# ── Google AdSense ───────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-YOUR_ADSENSE_ID

# ── Monitoring ───────────────────────────
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/PROJECT_ID
LOG_LEVEL=info

# ── Frontend (Next.js public vars) ───────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-YOUR_GA4_ID
NEXT_PUBLIC_APP_URL=http://localhost:3000
